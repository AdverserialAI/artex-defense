# syntax=docker/dockerfile:1
# 本地源码一体化构建：docker compose 使用此文件。
# 根目录 Dockerfile 仍用于 CI 预编译二进制打包，二者不要混用。

FROM node:22-bookworm@sha256:e13726ca604184d7a91fcacab1fc09eefd642dc28e79ac34e85540dd93b78cfb AS web-builder
ARG NEXT_PUBLIC_DSTACK_VERIFIER_URL=""
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_DSTACK_VERIFIER_URL=${NEXT_PUBLIC_DSTACK_VERIFIER_URL}
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build:static

FROM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS go-builder
ARG ARTEX_VERSION=0.1.5
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/norma ./third_party/norma
RUN go mod download
COPY . .
COPY --from=web-builder /src/web/out ./server/webui/dist
RUN CGO_ENABLED=0 go build -tags embedui -trimpath \
      -ldflags "-s -w -buildid= -X main.version=${ARTEX_VERSION}" \
      -o /out/artex ./cmd/artex \
    && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -buildid=" \
      -o /out/artex-defense ./cmd/artex-defense

# 运行层与根目录 Dockerfile 保持一致，仅把预编译 COPY 改为 builder 产物。
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ARG ARTEX_UID=10001 ARTEX_GID=10001
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN groupadd --gid ${ARTEX_GID} artex \
    && useradd --uid ${ARTEX_UID} --gid ${ARTEX_GID} --home-dir /home/artex --create-home --shell /usr/sbin/nologin artex
COPY --from=web-builder /usr/local/bin/ /usr/local/bin/
COPY --from=web-builder /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && rm -rf /var/lib/apt/lists/*

# 预装 Playwright MCP / CLI 与 Chromium，运行时不需首次联网下载。
RUN npm install -g @playwright/mcp@0.0.85 @playwright/cli@0.1.24 playwright@1.65.1 \
    && playwright-cli --help \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=go-builder /out/artex /app/artex
COPY --from=go-builder /out/artex-defense /app/artex-defense
COPY start.sh /app/start.sh
# start.sh 启动时即 source 配置迁移函数；upgrade-prompts 也依赖同目录 SQL。
COPY scripts/artex-config.sh scripts/upgrade-review-flow-prompts.sql /app/scripts/
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# JWT 签名密钥落到持久化数据卷，容器重建后旧登录 token 仍有效。
RUN ln -sf /app/data/jwt.key /app/jwt.key \
    && chmod +x /app/artex /app/artex-defense /app/start.sh /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /app/data /home/artex \
    && chown -R ${ARTEX_UID}:${ARTEX_GID} /app/data /app/skills /home/artex \
    && chmod -R a+rX /app /opt/playwright

VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
